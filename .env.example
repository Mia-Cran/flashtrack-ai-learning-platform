# Frontend settings. Copy to .env (git-ignored) if you need to override the default.
# Only variables starting with VITE_ are visible to the browser bundle.

# URL of the backend. Leave blank locally to use http://localhost:3001.
# On Vercel, set this in Project Settings -> Environment Variables to your
# deployed backend URL (no trailing slash), then redeploy.
VITE_API_BASE_URL=
