# Copy this file to backend/.env and fill in the values.
# backend/.env is ignored by git (see .gitignore), so your real values never get committed.
# Rules: no quotes, no spaces around "=", no "export " prefix.

# MongoDB connection string (local Mongo or an Atlas "mongodb+srv://..." URL)
MONGODB_URI=

# Any long random string. Used to sign login tokens.
JWT_SECRET=

# Your OpenAI API key (starts with "sk-")
OPENAI_API_KEY=

# Optional. Which OpenAI model writes study cards and quizzes. Defaults to
# gpt-5.5. Any model that supports the Responses API with JSON schema output
# works; pick a cheaper one here if cost matters more than quality.
OPENAI_MODEL=

# Optional. Defaults to 3001.
PORT=3001

# Optional. The frontend's URL, for CORS. Defaults to the Vite dev server
# (http://localhost:5173). In production set it to your Vercel URL, e.g.
# https://your-app.vercel.app  (comma-separate if you need more than one)
CLIENT_URL=
